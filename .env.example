# PostgreSQL connection string required by Prisma ORM.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a unique random value of at least 32 characters for each environment.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Node & Server
PORT=3000
NODE_ENV=development

# Platform Escrow Configurations
PLATFORM_DEFAULT_FEE_PCT=2.5
PLATFORM_FIXED_FEE_CENTS=30

# Optional AI assistant key.
GEMINI_API_KEY=""

# Current application URL.
APP_URL="http://localhost:3000"
